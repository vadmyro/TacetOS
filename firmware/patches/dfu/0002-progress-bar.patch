-/* One frame: the background everywhere, the logo in the middle, row by row. */
+/* One frame: the background everywhere, the logo in the middle, the empty bar, row by row. */
 static void draw_frame(void)
 {
     int at = 0;         /* next run of the logo */
@@ -198,8 +216,11 @@ static void draw_frame(void)
 
     for (int y = 0; y < LCD_HEIGHT && !gave_up; y++) {
         bool in_logo_row = y >= LOGO_Y && y < LOGO_Y + TACETOS_BOOT_LOGO_HEIGHT;
+        bool in_bar_row = y >= BAR_Y && y < BAR_Y + BAR_H;
         for (int x = 0; x < LCD_WIDTH; x++) {
             uint16_t pixel = tacetos_boot_logo_palette[0];
+            if (in_bar_row && x >= BAR_X && x < BAR_X + BAR_W)
+                pixel = BAR_TRACK;
             if (in_logo_row && x >= LOGO_X && x < LOGO_X + TACETOS_BOOT_LOGO_WIDTH) {
                 if (left == 0) {
                     colour = tacetos_boot_logo_palette[tacetos_boot_logo_data[at] >> 4];
@@ -289,12 +310,44 @@ void screen_start(void)
     else
         run8(lcd->seq_init);
 
-    lcd_window(cmd16);
+    lcd_window(cmd16, 0, 0, LCD_WIDTH, LCD_HEIGHT);
     lcd_mode(MODE_PIXELS);
     draw_frame();
     /* Back to commands: this waits for the last pixels to be taken. */
     lcd_mode(cmd16 ? MODE_CMD16 : MODE_CMD8);
 
-    if (!gave_up)
-        backlight_on();
+    if (gave_up)
+        return;
+    shown = true;
+    backlight_on();
+}
+
+/* Paints the columns from first to last (not included) of the bar in one colour. */
+static void bar_fill(int first, int last, uint16_t colour)
+{
+    bool cmd16 = lcd_target_get_info()->cmdset == LCD_CMDSET_16BIT;
+
+    lcd_window(cmd16, BAR_X + first, BAR_Y, last - first, BAR_H);
+    lcd_mode(MODE_PIXELS);
+    for (int i = (last - first) * BAR_H; i > 0 && !gave_up; i--)
+        lcd_data(colour);
+    /* Back to commands: this waits for the last pixels to be taken. */
+    lcd_mode(cmd16 ? MODE_CMD16 : MODE_CMD8);
+}
+
+void screen_progress(int percent)
+{
+    int columns = percent >= 100 ? BAR_W : percent * BAR_W / 100;
+
+    if (!shown || gave_up || columns <= bar_done)
+        return;
+    bar_fill(bar_done, columns, BAR_DONE);
+    bar_done = columns;
+}
+
+void screen_error(void)
+{
+    if (!shown || gave_up || bar_done == 0)
+        return;
+    bar_fill(0, bar_done, BAR_ERROR);
 }
