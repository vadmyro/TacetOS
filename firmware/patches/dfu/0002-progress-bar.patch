diff --git a/utils/mks5lboot/dualboot/dualboot.c b/utils/mks5lboot/dualboot/dualboot.c
--- a/utils/mks5lboot/dualboot/dualboot.c
+++ b/utils/mks5lboot/dualboot/dualboot.c
@@ -208,6 +208,46 @@ static uint32_t get_uint32le(unsigned char *p)
     return p[0] | (p[1] << 8) | (p[2] << 16) | (p[3] << 24);
 }
 
+/* The division of the runtime library calls this on a division by zero. It cannot
+   happen here (the divisors are sizes of images), so the answer is a reset. */
+void __div0(void)
+{
+    WDTCON = 0x100000;
+    while (1);
+}
+
+/* Writes an IM3 image like im3_write() does, a sector at a time, and moves the bar
+   from the percent 'from' to the percent 'to' on the way. The check is a separate
+   step (im3_check), so that the bar can show it as the last part of the install. */
+static void im3_write_bar(int offset, void *im3_addr, int from, int to)
+{
+    struct Im3Info *hinfo = (struct Im3Info *)im3_addr;
+    uint32_t size = get_uint32le(hinfo->data_sz) + IM3HDR_SZ;
+    uint32_t done = 0;
+
+    bootflash_init(SPI_PORT);
+    while (done < size) {
+        uint32_t part = MIN(0x1000 - ((offset + done) & 0xfff), size - done);
+        bootflash_write(SPI_PORT, offset + done, (uint8_t *)im3_addr + done, part);
+        done += part;
+        screen_progress(from + (to - from) * done / size);
+    }
+    bootflash_close(SPI_PORT);
+}
+
+/* True when the IM3 image in the NOR is what is in memory. */
+static bool im3_check(int offset, void *im3_addr)
+{
+    struct Im3Info *hinfo = (struct Im3Info *)im3_addr;
+    bool res;
+
+    bootflash_init(SPI_PORT);
+    res = !(bootflash_compare(SPI_PORT, offset, im3_addr,
+                              get_uint32le(hinfo->data_sz) + IM3HDR_SZ) & 1);
+    bootflash_close(SPI_PORT);
+    return res;
+}
+
