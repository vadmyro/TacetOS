+#define BAR_TRACK   0x39e8  /* #3A3D44 */
+#define BAR_DONE    0xffff  /* #FFFFFF */
+#define BAR_ERROR   0xe249  /* #E5484D */
+
 /* Set by the first wait that runs out: from then on nothing touches the screen. */
