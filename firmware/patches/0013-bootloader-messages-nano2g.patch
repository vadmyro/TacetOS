Subject: Say TacetOS in the Nano 2G bootloader messages

The title, loading and loaded lines of the bootloader for the iPod Nano 2G,
which the bootloader messages patch did not cover. The error for a missing
firmware file no longer prints the file name.

diff --git a/bootloader/ipodnano2g.c b/bootloader/ipodnano2g.c
index 23a3557a..c8fcf8ce 100644
--- a/bootloader/ipodnano2g.c
+++ b/bootloader/ipodnano2g.c
@@ -203,7 +203,7 @@ void main(void)
 
     lcd_setfont(FONT_SYSFIXED);
 
-    printf("Rockbox boot loader");
+    printf("TacetOS boot loader");
     printf("Version: %s", rbversion);
 
     i = storage_init();
@@ -237,17 +237,17 @@ void main(void)
 
         aes_decrypt(loadbuffer, size);
     } else {
-        printf("Loading Rockbox...");
+        printf("Loading TacetOS...");
         rc=load_firmware(loadbuffer, BOOTFILE, MAX_LOADSIZE);
 
         if (rc <= EFILE_EMPTY) {
             printf("Error!");
-            printf("Can't load " BOOTFILE ": ");
+            printf("Can't load the firmware file:");
             printf(loader_strerror(rc));
             fatal_error();
         }
 
-        printf("Rockbox loaded.");
+        printf("TacetOS loaded.");
     }
 
 
