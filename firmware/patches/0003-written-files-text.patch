Subject: Say TacetOS in the text of the files the firmware writes

The first line of saved settings, the playlists made from a cue file, the
scrobbler log, saved Go games and the header the firmware writes in MP3
files name TacetOS, with no web address.

diff --git a/apps/plugins/cue_playlist.c b/apps/plugins/cue_playlist.c
index d3f64fcc..689ac588 100644
--- a/apps/plugins/cue_playlist.c
+++ b/apps/plugins/cue_playlist.c
@@ -252,7 +252,7 @@ static void init_new_cue(const char *playlist_filename)
     if (cps.cue_fd >= 0)
     {
         rb->lseek(cps.cue_fd, 0, SEEK_SET);
-        rb->fdprintf(cps.cue_fd, "REM COMMENT \"generated by Rockbox version: " \
+        rb->fdprintf(cps.cue_fd, "REM COMMENT \"generated by TacetOS version: " \
                                  "%s\"\n", rb->rbversion);
 
         rb->fdprintf(cps.cue_fd, "TITLE \"%s\"\n", playlist_filename); /* top level TITLE */
diff --git a/apps/plugins/goban/sgf_output.c b/apps/plugins/goban/sgf_output.c
index 6a52789f..194d71af 100644
--- a/apps/plugins/goban/sgf_output.c
+++ b/apps/plugins/goban/sgf_output.c
@@ -130,7 +130,7 @@ output_header_props (void)
 {
     char buffer[128];
 
-    rb->strlcpy (buffer, "GM[1]FF[4]CA[UTF-8]AP[Rockbox Goban:1.0]ST[2]\n\n",
+    rb->strlcpy (buffer, "GM[1]FF[4]CA[UTF-8]AP[TacetOS Goban:1.0]ST[2]\n\n",
                  sizeof (buffer));
     write_file (sgf_fd, buffer, rb->strlen (buffer));
 
diff --git a/apps/plugins/lastfm_scrobbler.c b/apps/plugins/lastfm_scrobbler.c
index 1cc01a1a..1cde023b 100644
--- a/apps/plugins/lastfm_scrobbler.c
+++ b/apps/plugins/lastfm_scrobbler.c
@@ -529,7 +529,7 @@ static int sbl_check_or_open(bool check_only)
         {
             /* write file header */
             rb->fdprintf(fd, "#AUDIOSCROBBLER/" SCROBBLER_VERSION "\n"
-                         "#TZ/UNKNOWN\n" "#CLIENT/Rockbox "
+                         "#TZ/UNKNOWN\n" "#CLIENT/TacetOS "
                          TARGET_NAME SCROBBLER_REVISION
                          HDR_STR_TIMELESS "\n");
             rb->fdprintf(fd, ITEM_HDR);
diff --git a/apps/settings.c b/apps/settings.c
index 5f96a1c4..239cd726 100644
--- a/apps/settings.c
+++ b/apps/settings.c
@@ -566,8 +566,7 @@ static bool settings_write_config(const char* filename, int options)
 
     if (options != SETTINGS_SAVE_RESUMEINFO)
     {
-        fdprintf(fd, "# .cfg file created by rockbox %s - "
-                 "http://www.rockbox.org\r\n\r\n", rbversion);
+        fdprintf(fd, "# .cfg file created by TacetOS %s\r\n\r\n", rbversion);
     }
 
     for(i=0; i<nb_settings; i++)
diff --git a/lib/rbcodec/metadata/mp3data.c b/lib/rbcodec/metadata/mp3data.c
index a6a44851..4f51f37a 100644
--- a/lib/rbcodec/metadata/mp3data.c
+++ b/lib/rbcodec/metadata/mp3data.c
@@ -685,7 +685,7 @@ int count_mp3_frames(int fd,  int startpos,  int filesize,
     }
 }
 
-static const char cooltext[] = "Rockbox - rocks your box";
+static const char cooltext[] = "TacetOS";
 
 /* buf needs to be the audio buffer with TOC generation enabled,
    and at least MAX_XING_HEADER_SIZE bytes otherwise */
