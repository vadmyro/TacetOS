Subject: Rename the default icons and failsafe themes

The themes are listed as default_icons and failsafe, and the firmware code
that loads the failsafe theme by name follows. Their author is the TacetOS
team.

diff --git a/apps/gui/skin_engine/skin_engine.c b/apps/gui/skin_engine/skin_engine.c
index f54d1bc7..073c3fd5 100644
--- a/apps/gui/skin_engine/skin_engine.c
+++ b/apps/gui/skin_engine/skin_engine.c
@@ -40,7 +40,7 @@
 #include "statusbar-skinned.h"
 #include "wps_internals.h"
 
-#define FAILSAFENAME "rockbox_failsafe"
+#define FAILSAFENAME "failsafe"
 
 void skin_data_free_buflib_allocs(struct wps_data *wps_data);
 #ifdef HAVE_ALBUMART
diff --git a/wps/WPSLIST b/wps/WPSLIST
index 596f5487..b8d7b8a2 100644
--- a/wps/WPSLIST
+++ b/wps/WPSLIST
@@ -20,8 +20,8 @@
 # All sections should list what font and status bar setting they "like".
 
 <theme>
-Name: rockbox_default_icons
-Author: Rockbox team
+Name: default_icons
+Author: TacetOS team
 
 <main>
 iconset: -
@@ -39,8 +39,8 @@ viewers iconset..+x2: icons/viewers.6x8x2.bmp
 </theme>
 
 <theme>
-Name: rockbox_failsafe
-Author: Rockbox team
+Name: failsafe
+Author: TacetOS team
 
 WPS: yes
 RWPS: yes
@@ -69,7 +69,7 @@ ui viewport: -
 <theme>
 Name: cabbiev2
 # Real name of the creator of the WPS
-Authors: Johannes Voggenthaler, Apoo Maha, Marc Guay, Alex Vanderpol, Jerry Lange, Keith Perri, Mark Fawcus, and Marianne Arnold with support from Rockbox developers and forums. Based on Cabbie by Yohann Misquitta.
+Authors: Johannes Voggenthaler, Apoo Maha, Marc Guay, Alex Vanderpol, Jerry Lange, Keith Perri, Mark Fawcus, and Marianne Arnold with support from developers and forums. Based on Cabbie by Yohann Misquitta.
 WPS: yes
 FMS: yes
 RWPS: yes
