Subject: Hide the firmware folder and boot file, and plugin extensions

At the root of the volume the browser skips the firmware folder (this build's
and the one the bootloader looks for) and the boot file, whatever "Show files"
says. Plugin files never show their extension.

diff --git a/apps/filetree.c b/apps/filetree.c
index 4d682166..d448cbf0 100644
--- a/apps/filetree.c
+++ b/apps/filetree.c
@@ -297,6 +297,30 @@ static int compare(const void* p1, const void* p2)
 }
 
 /* load and sort directory into the tree's cache. returns NULL on failure. */
+/* Technical names at the root of the volume that must never be seen: the
+   firmware folder (the one of this build and the one the bootloader looks
+   for) and the boot file. */
+static bool is_technical_name(const char *name)
+{
+    const char *plugdir = PLUGIN_DIR;
+    size_t len = strlen(plugdir + 1);
+    const char *slash = strchr(plugdir + 1, '/');
+    if (slash)
+        len = slash - (plugdir + 1);
+
+    if (strlen(name) == len && !strncasecmp(name, plugdir + 1, len))
+        return true;
+#ifdef BOOTDIR
+    if (!strcasecmp(name, BOOTDIR + 1))
+        return true;
+#endif
+#ifdef BOOTFILE
+    if (!strcasecmp(name, BOOTFILE))
+        return true;
+#endif
+    return false;
+}
+
