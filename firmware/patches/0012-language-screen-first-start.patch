new file mode 100644
index 00000000..13c97353
--- /dev/null
+++ b/apps/language_screen.h
@@ -0,0 +1,15 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 vadmyro
+ *
+ * The language screen of the first start.
+ */
+#ifndef LANGUAGE_SCREEN_H
+#define LANGUAGE_SCREEN_H
+
+/* Shows the list of languages of the language list file, with no title and no
+   way out but a choice, sets the language chosen and saves the settings at
+   once. Does nothing when the list file is missing or offers no language. */
+void language_screen_first_start(void);
+
+#endif
