@@ -0,0 +1,153 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 vadmyro
+ *
+ * The language screen of the first start. The languages come from the list file
+ * of the language folder: one language per line, the name of its language file
+ * without the extension, a tab, then its name written in that language. A line
+ * starting with # is a comment. A language is offered when its file is there
+ * (English is built in, so it always is).
+ */
+#include <stdbool.h>
+#include <stdio.h>
+#include <string.h>
+#include <string-extra.h>
+#include "config.h"
+#include "action.h"
+#include "file.h"
+#include "kernel.h"
+#include "lang.h"
+#include "language.h"
+#include "list.h"
+#include "misc.h"
+#include "rbpaths.h"
+#include "settings.h"
+#include "talk.h"
+#include "viewport.h"
+#include "language_screen.h"
+
+#define LANGUAGE_LIST_FILE LANG_DIR "/languages.txt"
+#define LANGUAGE_BUILTIN   "english"
+#define LANGUAGE_MAX       24
+
+struct language_entry {
+    char file[sizeof(((struct user_settings *)0)->lang_file)];
+    char name[48];
+};
+
+static struct language_entry entries[LANGUAGE_MAX];
+static int entry_count;
+
+static const char *entry_name(int selected, void *data, char *buffer, size_t buffer_len)
+{
+    (void)data;
+    (void)buffer;
+    (void)buffer_len;
+    return entries[selected].name;
+}
+
+/* No way out: the buttons that leave a list do nothing. */
+static int entry_action(int action, struct gui_synclist *lists)
+{
+    (void)lists;
+    if (action == ACTION_STD_CANCEL || action == ACTION_STD_MENU)
+        return ACTION_NONE;
+    return action;
+}
+
+static void add_entry(char *line)
+{
+    char *name = strchr(line, '\t');
+    if (!name || entry_count >= LANGUAGE_MAX)
+        return;
+    *name++ = '\0';
+
+    char *file = line;
+    while (*file == ' ')
+        file++;
+    while (*name == ' ')
+        name++;
+    size_t file_len = strlen(file);
+    while (file_len > 0 && file[file_len - 1] == ' ')
+        file[--file_len] = '\0';
+    size_t name_len = strlen(name);
+    while (name_len > 0 && name[name_len - 1] == ' ')
+        name[--name_len] = '\0';
+
+    struct language_entry *entry = &entries[entry_count];
+    if (file_len == 0 || file_len >= sizeof(entry->file) || name_len == 0
+        || name_len >= sizeof(entry->name) || strchr(file, '/'))
+        return;
+
+    if (strcmp(file, LANGUAGE_BUILTIN) != 0) {
+        char path[MAX_PATH];
+        snprintf(path, sizeof(path), LANG_DIR "/%s.lng", file);
+        if (!file_exists(path))
+            return;
+    }
+    strcpy(entry->file, file);
+    strcpy(entry->name, name);
+    entry_count++;
+}
+
+static void read_entries(void)
+{
+    char line[96];
+    int fd = open_utf8(LANGUAGE_LIST_FILE, O_RDONLY);
+
+    entry_count = 0;
+    if (fd < 0)
+        return;
+    while (read_line(fd, line, sizeof(line)) > 0) {
+        if (line[0] != '#')
+            add_entry(line);
+    }
+    close(fd);
+}
+
+/* Sets the language of an entry as the Language setting would. False when its
+   file cannot be loaded. */
+static bool choose(const struct language_entry *entry)
+{
+    if (strcmp(entry->file, LANGUAGE_BUILTIN) == 0) {
+        global_settings.lang_file[0] = '\0';
+        return true;
+    }
+
+    char path[MAX_PATH];
+    snprintf(path, sizeof(path), LANG_DIR "/%s.lng", entry->file);
+    if (lang_core_load(path))
+        return false;
+    strlcpy((char *)global_settings.lang_file, entry->file, sizeof(global_settings.lang_file));
+    talk_init();
+    viewportmanager_theme_changed(THEME_LANGUAGE);
+    settings_apply_skins();
+    return true;
+}
+
+void language_screen_first_start(void)
+{
+    read_entries();
+    if (entry_count == 0)
+        return;
+
+    for (;;) {
+        struct simplelist_info info;
+        bool usb;
+
+        simplelist_info_init(&info, NULL, entry_count, NULL);
+        info.get_name = entry_name;
+        info.action_callback = entry_action;
+        info.speak_onshow = false;
+        usb = simplelist_show_list(&info);
+        if (usb) {
+            /* The USB screen came and went: the list leaves without undoing its viewports. */
+            FOR_NB_SCREENS(i)
+                viewportmanager_theme_undo(i, false);
+            continue;
+        }
+        if (info.selection >= 0 && info.selection < entry_count && choose(&entries[info.selection]))
+            break;
+    }
+    settings_save_now();
+}
