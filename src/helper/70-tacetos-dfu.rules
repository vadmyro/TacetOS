#
# Lets the logged-in user talk to an iPod Classic in DFU mode, so that the
# bootloader can be installed without root. It matches the DFU id 05ac:1223 and
# no other, so it never touches an iPod in normal mode. The rule is applied when
# the device appears: enter DFU mode again after installing it.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="05ac", ATTR{idProduct}=="1223", TAG+="uaccess"
