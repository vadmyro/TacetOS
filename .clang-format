---
Language: Cpp
BasedOnStyle: LLVM
Standard: c++17
IndentWidth: 4
ColumnLimit: 100
AccessModifierOffset: -4
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterFunction: true
  AfterNamespace: false
  AfterStruct: true
PointerAlignment: Right
AllowShortFunctionsOnASingleLine: Inline
IncludeBlocks: Regroup
...
